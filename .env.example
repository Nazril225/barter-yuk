# ============================================================
# BarterYuk! — Contoh konfigurasi database LOKAL
# ============================================================
#
# CARA PAKAI:
#   1. Salin berkas ini menjadi:  .env
#      (perintah: cp .env.example .env)
#   2. Isi nilainya sesuai instalasi MySQL/MariaDB di komputermu.
#   3. Berkas .env DIABAIKAN Git (lihat .gitignore), sehingga kata sandi
#      TIDAK akan ikut ter-commit.
#
# CATATAN PENTING:
#   - JANGAN pernah menulis kata sandi asli ke berkas contoh ini.
#   - JANGAN gunakan akun `root` untuk aplikasi; gunakan `barteryuk_app`.
#   - PHP tidak otomatis memuat .env; berkas koneksi.php memuatnya sendiri.
#   - Sebagai alternatif, set environment variable berikut sebelum
#     menjalankan PHP (lihat README, bagian "Menjalankan & Migrasi MySQL").
# ============================================================

# Host dapat berupa 127.0.0.1 (disarankan di macOS) atau localhost.
BARTERYUK_DB_HOST=127.0.0.1

# Port default MySQL.
BARTERYUK_DB_PORT=3306

# Nama database (sudah dibuat, tanpa tabel).
BARTERYUK_DB_NAME=barteryuk

# Akun aplikasi (BUKAN root).
BARTERYUK_DB_USER=barteryuk_app

# Kata sandi akun aplikasi. ISI DI BERKAS .env, JANGAN DI SINI.
BARTERYUK_DB_PASS=
